BOT_TOKEN=
# ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=7819062310
# Firebase: JSON сервисного аккаунта ОДНОЙ строкой (см. FIREBASE_SETUP.md)
FIREBASE_CREDENTIALS=
# или путь к файлу ключа (для локального запуска)
# FIREBASE_CREDENTIALS_FILE=./serviceAccount.json
# необязательно, но точнее для Бишкека: ключ 2ГИС API
DGIS_KEY=

# необязательно: напоминания о зависших заказах (минуты в статусе)
